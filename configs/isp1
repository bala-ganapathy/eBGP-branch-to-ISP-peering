frr version 8.4_git
frr defaults traditional
hostname isp1
no ipv6 forwarding
!
interface eth1
 ip address 192.168.11.1/30
exit
!
interface eth2
 ip address 172.16.1.1/30
exit
!
router bgp 100
 bgp router-id 192.168.11.1
 no bgp ebgp-requires-policy
 neighbor 172.16.1.2 remote-as 888
 neighbor 192.168.11.2 remote-as 65001
exit
!
